diff --git a/recipe/build.sh b/recipe/build.sh
index c9b699b..1aa3067 100644
--- a/recipe/build.sh
+++ b/recipe/build.sh
@@ -54,14 +54,22 @@ make install
 
 cd ../python
 
-python setup.py install
+# Use pip install instead of deprecated setup.py install
+pip install . --no-deps --no-build-isolation -v
 
 SYS_PYTHON_MAJOR=$(python -c "import sys;print(sys.version_info.major)")
 SYS_PYTHON_MINOR=$(python -c "import sys;print(sys.version_info.minor)")
-if [[ "${SYS_PYTHON_MINOR}" -gt '7' ]]; then
-    patchelf --page-size ${PAGE_SIZE} --set-rpath $LD_LIBRARY_PATH $PREFIX/lib/python${SYS_PYTHON_MAJOR}.${SYS_PYTHON_MINOR}/site-packages/sentencepiece-$PKG_VERSION-py${SYS_PYTHON_MAJOR}.${SYS_PYTHON_MINOR}-linux-${ARCH}.egg/sentencepiece/_sentencepiece.cpython-${CONDA_PY}-${ARCH_SO_NAME}-linux-gnu.so
+
+# Dynamically find the sentencepiece .so file (handles both egg and flat installs)
+SP_SO=$(find $PREFIX/lib/python${SYS_PYTHON_MAJOR}.${SYS_PYTHON_MINOR}/site-packages -name "_sentencepiece*.so" 2>/dev/null | head -1)
+
+if [[ -n "$SP_SO" && -f "$SP_SO" ]]; then
+    echo "Found sentencepiece .so at: $SP_SO"
+    patchelf --page-size ${PAGE_SIZE} --set-rpath $LD_LIBRARY_PATH "$SP_SO"
 else
-    patchelf --page-size ${PAGE_SIZE} --set-rpath $LD_LIBRARY_PATH $PREFIX/lib/python${SYS_PYTHON_MAJOR}.${SYS_PYTHON_MINOR}/site-packages/sentencepiece-$PKG_VERSION-py${SYS_PYTHON_MAJOR}.${SYS_PYTHON_MINOR}-linux-${ARCH}.egg/sentencepiece/_sentencepiece.cpython-${CONDA_PY}m-${ARCH_SO_NAME}-linux-gnu.so
+    echo "Warning: Could not find sentencepiece .so file to patch, skipping patchelf"
+    # List what's in site-packages for debugging
+    find $PREFIX/lib/python${SYS_PYTHON_MAJOR}.${SYS_PYTHON_MINOR}/site-packages -name "*sentencepiece*" -ls
 fi
 
 exit 0
